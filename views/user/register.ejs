<% layout("layouts/boilerplate") %>
<div class="container">
    <h1> User Registeration </h1>
    <form id="regForm" action="/user/register" method="POST">
        <div class="col">
            <section class="row">
                <i><b>Personal Information:</b></i>
            </section>

            <section class="row">

                <label for="firstName">Name: </label>
                <input type="text" id="firstName" name="firstName" size="15" placeholder="first">
                <input type="text" id="lastName" name="lastName" size="20" placeholder="* last" required>
                <span>
                    <label for="age">Age:</label>
                    <input class="ml-5" type="number" id="age" name="age" min="5" max="120" placeholder="yrs">
                </span>

            </section>

            <section class="row">
                <span class="">
                    <label for="phone">Phone:</label>
                    <input type="number" id="phone" name="phone" placeholder="* contact no." required>
                </span>
                <span class="">
                    <label for="email">email:</label>
                    <input type="email" id="email" name="email" placeholder="email@gmail.com">
                </span>
            </section>

            <section class="row">
                <label for="shopNo">Address:</label>
                <input type="text" id="shopNo" name="shopNo" size="15" placeholder="* shop no. landmark" required>
                <input type="text" id="city" name="city" size="15" placeholder="* city" required>
                <input type="text" id="state" name="state" size="10" placeholder="* state" required>
            </section>
        </div>
        <div class="container">
            <section>
                <i><b>Create Login credentials: </b></i>
            </section>

            <section>
                <span class="row">
                    <label class="col container" for="username">Username: </label>
                    <input class="btn btn-sm" type="text" id="username" name="username" placeholder="username" required>
                </span>
                <span class="row">
                    <label class="col container" for="password">Password: </label>
                    <input class="btn btn-sm" type="password" id="password" name="password" placeholder="password"
                        required>
                </span>
                <span class="row">
                    <label class="col container" for="confirmPass">Confirm Password: </label>
                    <input class="btn btn-sm" type="password" id="confirmPass" placeholder="confirm password" required>
                </span>
            </section>

            <section class="container">
                <button class="btn btn-green" type="submit">Register</button>
            </section>
        </div>
    </form>
</div>

<script src="/javascripts/eventMatchPassword.js"></script>