<% layout("layouts/boilerplate") %>

<div class="container">
    <h1>@<%= user.username %></h1>
    <div class="col">
        <div class="row box justify-center">
            <div class="col">
                <table>
                    <tbody>
                        <tr>
                            <td><b>Name</b></td>
                            <td><%= user.name || "-" %></td>
                        </tr>
                        <tr>
                            <td><b>Age</b></td>
                            <td><%= user.age || "-" %></td>
                        </tr>
                        <tr>
                            <td><b>Phone</b></td>
                            <td><%= user.phone || "-" %></td>
                        </tr>
                        <tr>
                            <td><b>Email</b></td>
                            <td><%= user.email || "-" %></td>
                        </tr>
                        <tr>
                            <td><b>Address</b></td>
                            <td><%= user.address || "-" %></td>
                        </tr>
                    </tbody>
                </table>
                <div class="row justify-center">
                    <button class="btn btn-lg btn-yellow"><a href="/user/profile/edit">Edit Info</a></button>
                </div>
            </div>
        </div>
    </div>
</div>