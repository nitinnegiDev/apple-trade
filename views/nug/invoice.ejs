<% layout("layouts/boilerplate") %>


<div class="container">
    <h1>CUSTOMER INVOICE</h1>
    <form action="/records/<%= orchard._id %>/nugs/<%= index %>/saveInvoice" method="POST">
        <table id="invoice" class="bill-table text-center" width="100%">
            <thead>
                <tr>
                    <th colspan="9">
                        <%= orchard.aadti.name.toUpperCase() %>
                        <br>
                        <%= orchard.aadti.address %>
                    </th>
                    <th colspan="1">
                        Date : <%= new Date().toLocaleDateString() %>
                    </th>
                </tr>
                <tr>
                    <th colspan="7">
                        <div class="row">
                            Grower Name: <%= orchard.owner.toUpperCase() %>
                        </div>
                    </th>
                    <th colspan="3">
                        <div class="row">
                            Marka: <%= lot.marka.toUpperCase() %>
                        </div>
                    </th>
                </tr>
                <tr>
                    <th colspan="10">
                        <div class="row flex-start">
                            Address: <%= orchard.address %>
                        </div>
                    </th>
                </tr>
                <tr>
                    <th colspan="9">Lot Details &#40; <%= lot.variety ? lot.variety.toUpperCase() : "" %> &#41;</th>
                    <th rowspan="2">Total</th>
                </tr>
                <tr>
                    <th scope="row">Box Type</th>
                    <% Object.keys(lot.nugsInfo).forEach((boxType) => { %>

                    <% if(lot.nugsInfo[boxType]) { %>
                    <th scope="col"><%= boxType %></th>
                    <% } else { %>
                    <th scope="col"><%= boxType %></th>
                    <% } %>

                    <% }) %>
                </tr>

                <tr>
                    <th scope="row">Num of Boxes</th>
                    <% Object.keys(lot.nugsInfo).forEach((boxType) => { %>

                    <% if(lot.nugsInfo[boxType]) { %>
                    <td id="boxCount" class="<%= boxType %>"><%= lot.nugsInfo[boxType] %></td>
                    <% } else { %>
                    <td>-</td>
                    <% } %>

                    <% }) %>
                    <td class="blue" id="totalBoxes"></td>
                </tr>
                <tr>
                    <th scope="row">Price per box</th>

                    <% Object.keys(lot.nugsInfo).forEach((boxType) => { %>

                    <% if(lot.nugsInfo[boxType]) { %>
                    <td>
                        <input id="boxPrice" name="<%= boxType %>" class="text-center" type="number" min="1"
                            max="100000" placeholder="price">
                        <b class="display-none"></b>
                    </td>

                    <% } else { %>
                    <td>-</td>
                    <% } %>

                    <% }) %>
                    <td class="blue" id="totalPrice">-</td>
                </tr>
                <tr>
                    <th colspan="10">Expenses</th>
                </tr>
                <tr>
                    <th colspan="9" scope="row">
                        Freight &#40; per box
                        <input id="expense" class="text-center" name="expense[freight]" type="number" min="0"
                            max="10000" placeholder="per box">
                        <b class="display-none"></b>
                        rs &#41;
                    </th>
                    <td class="blue">-</td>
                </tr>
                <tr>
                    <th colspan="9" scope="row">
                        Labour &#40; per box
                        <input id="expense" class="text-center" name="expense[labour]" type="number" min="0" max="10000"
                            placeholder="per box">
                        <b class="display-none"></b>
                        rs &#41;
                    </th>
                    <td class="blue">-</td>
                </tr>
                <tr>
                    <th colspan="9" scope="row">
                        Storage Charges &#40; per box
                        <input id="expense" class="text-center" name="expense[storage]" type="number" min="0"
                            max="10000" placeholder="per box">
                        <b class="display-none"></b>
                        rs &#41;
                    </th>
                    <td class="blue">-</td>
                </tr>
                <tr>
                    <th colspan="9" scope="row">
                        Stationary &#40;
                        <input id="expense" class="text-center singleExpense" name="expense[stationary]" type="number"
                            min="0" max="10000" placeholder="total">
                        <b class="display-none"></b>
                        rs &#41;
                    </th>
                    <td class="blue">-</td>
                </tr>
                <tr>
                    <th colspan="9" scope="row">
                        Others &#40;
                        <input id="expense" class="text-center singleExpense" name="expense[others]" type="number"
                            min="0" max="10000" placeholder="total">
                        <b class="display-none"></b>
                        rs &#41;
                    </th>
                    <td class="blue">-</td>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th colspan="9" scope="row">Total Payable</th>
                    <td id="totalPayable" class="blue">-</td>
                    <input id="totalPayableInput" type="number" name="totalPayable" hidden>
                </tr>
            </tfoot>
        </table>

        <div class="row justify-center">
            <button id="download" class="btn btn-lg btn-green">
                Download Invoice
            </button>

            <button type="submit" class="btn btn-lg">
                Save &#8594;
            </button>
        </div>

    </form>
</div>

<script src="/javascripts/generateInvoice.js"></script>
<script src="/javascripts/downloadInvoice.js"></script>